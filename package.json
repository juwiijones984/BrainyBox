{
  "name": "ntes-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit && tsc --noEmit --target ES2020 --module ESNext --moduleResolution bundler --strict --skipLibCheck --types node scripts/provision.ts scripts/rules-matrix.ts",
    "test": "tsx scripts/check-parser.ts && tsx scripts/check-data.ts",
    "provision": "tsx scripts/provision.ts",
    "rules:matrix": "tsx scripts/rules-matrix.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-admin": "^14.5.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
