# Environment
#
# Copy this file to `.env` and fill in the values from your Firebase project
# (Project settings → Your apps → Web app → SDK setup and configuration).
#
# These values are shipped to the browser in the built bundle. They are NOT
# secrets — the Firebase web config is designed to be public. What actually
# protects the data is `firestore.rules` and `storage.rules`, which are
# deployed separately and enforced by Google, not by this file.
#
# Without these four the app renders a setup screen naming the missing
# variables. It will not fall back to local storage, because a progress figure
# that did not come from a real attempt would be a fabricated one.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. Defaults to `${VITE_FIREBASE_PROJECT_ID}.appspot.com`.
# Newer projects are served from `<project>.firebasestorage.app` instead, so copy
# the value from the console rather than relying on the default.
VITE_FIREBASE_STORAGE_BUCKET=

# Optional. Only needed if push notifications are added later.
VITE_FIREBASE_MESSAGING_SENDER_ID=
